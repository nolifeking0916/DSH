{
  "name": "@local/wikiskill-inject",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Inject a skill index and relevant wiki patterns before each user turn (WikiSkill execution layer).",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
